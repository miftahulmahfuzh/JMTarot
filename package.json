{
  "name": "jmtarot",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "RES_OPTIONS=no-aaaa next dev",
    "build": "npm run db:migrate:deploy && RES_OPTIONS=no-aaaa next build && npm run audit:secrets",
    "db:migrate:deploy": "RES_OPTIONS=no-aaaa tsx scripts/db-migrate-deploy.ts",
    "audit:secrets": "RES_OPTIONS=no-aaaa NODE_OPTIONS=--conditions=react-server tsx scripts/audit-secrets.ts",
    "start": "RES_OPTIONS=no-aaaa next start",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d && until pg_isready -h 127.0.0.1 -p 5432 -q; do sleep 1; done && echo 'postgres ready' && npm run --silent srh:wait",
    "srh:wait": "for i in $(seq 1 20); do curl -sf -o /dev/null -X POST -H 'Authorization: Bearer jmtarot-test-token' -H 'Content-Type: application/json' -d '[\"PING\"]' http://127.0.0.1:8079 && echo 'srh ready' && exit 0; sleep 1; done; echo 'srh NOT ready -- the redis integration suite will SKIP, not fail'; exit 0",
    "db:down": "docker compose down",
    "db:nuke": "docker compose down -v",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:test:reset": "tsx scripts/db-test-reset.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "cards": "python3 tools/generate_cards.py",
    "assets": "python3 tools/normalize_cards.py",
    "wallpapers": "python3 tools/make_wallpapers.py",
    "smoke": "RES_OPTIONS=no-aaaa NODE_OPTIONS=--conditions=react-server tsx scripts/smoke-llm.ts",
    "probe:moderation": "RES_OPTIONS=no-aaaa NODE_OPTIONS=--conditions=react-server tsx scripts/probe-moderation.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.4",
    "next": "^16.2.11",
    "next-auth": "5.0.0-beta.32",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "esbuild@0.28.1": true
  }
}
