# Copy to .env.local and fill in. .env.local is gitignored and must stay that way.

# --- LLM -------------------------------------------------------------------
# `zai` and `anthropic` share one adapter: the wire format is identical, so
# only these three values differ between them.
LLM_PROVIDER=zai
LLM_BASE_URL=https://api.z.ai/api/anthropic
LLM_API_KEY=replace-me
LLM_MODEL=glm-4.6

# --- Auth ------------------------------------------------------------------
# 32+ random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-me-with-32-plus-random-bytes-base64

# One bcrypt hash per user, cost 12:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" 'the-password'
# Must be valid JSON on a single line. A malformed value fails closed (no
# logins) rather than open -- see src/lib/auth/users.ts.
#
# ESCAPE EVERY $ AS \$ IN THIS FILE AND IN .env.local. Next expands $VAR
# references when it loads a .env file, so a raw bcrypt hash has its `$2b` and
# `$12` substituted away as undefined variables and arrives mangled. The
# symptom is a 500 and "AUTH_USERS entry 0 must be..." on a hash that is
# demonstrably valid when you parse the same file by hand -- an hour of
# confusion for one backslash.
#
# This applies ONLY to .env files. Values set in the Vercel dashboard are
# literal, so paste the hash there with its dollars intact and NO backslashes.
AUTH_USERS=[{"u":"miftah","h":"\$2b\$12\$replace.me.with.a.real.bcrypt.hash.00000000000000000"},{"u":"jodith","h":"\$2b\$12\$replace.me.with.a.real.bcrypt.hash.00000000000000000"}]
