# Copy to .env.local and fill in. .env.local is gitignored and must stay that way.
#
# ---------------------------------------------------------------------------
# THE `$` RULE, IN ONE PLACE. Each variable below repeats the part that applies
# to it; this is the summary, because the answer is per-value and getting it
# backwards fails in both directions.
#
# Next expands `$VAR` when it loads a .env file, so a value CONTAINING a dollar
# sign arrives mangled unless every `$` is written `\$`.
#
#   NEEDS ESCAPING       AUTH_USERS (bcrypt hashes are full of `$`)
#                        DATABASE_URL / TEST_DATABASE_URL, IF the password has
#                        one -- the dev password is alphanumeric so it does not
#
#   DOES NOT             AUTH_SECRET, FIELD_ENCRYPTION_KEY, CRON_SECRET
#                        (base64/base64url: no `$` in either alphabet)
#                        AUTH_GOOGLE_SECRET (starts `GOCSPX-`, no `$`)
#                        every MODERATION_*, TERMS_VERSION, EVENTS_RETENTION_DAYS
#
# **AND IT APPLIES ONLY TO .env FILES. VERCEL DASHBOARD VALUES ARE LITERAL** --
# paste the hash there with its dollars intact and NO backslashes. Escaping in
# the dashboard breaks the value just as thoroughly as not escaping here.
# ---------------------------------------------------------------------------

# --- LLM -------------------------------------------------------------------
# `zai` and `anthropic` share one adapter: the wire format is identical, so
# only these three values differ between them.
LLM_PROVIDER=zai
# `openai` IS THE SECOND PROVIDER, and it is insurance rather than a preference:
# z.ai's Coding Plan is "strictly limited to use within officially supported
# tools and products" and JMTarot is not one, so the single-provider risk is a
# terms decision no code can bound.
#
# ===========================================================================
# THE EMERGENCY FALLBACK. Four lines, and no base URL to remember.
# ===========================================================================
#   LLM_PROVIDER=gemini
#   LLM_API_KEY=<your Google AI Studio key>
#   LLM_MODEL=gemini-3.5-flash-lite
#   MODERATION_MODEL=gemini-3.5-flash-lite
#
# `gemini` is the OpenAI adapter pointed at Google's OpenAI-compatible endpoint --
# no second adapter, no OPENAI_BASE_URL to set. It is a NAMED provider precisely
# so the failover path has nothing to forget: `LLM_PROVIDER=openai` with a Google
# key would 401 in a way that reads like a bad key.
#
# **USE THE PAID TIER. THIS IS A PRIVACY REQUIREMENT, NOT A QUOTA ONE.**
# Google marks FREE-tier content as used to improve its products; paid tier is
# excluded. Every request here carries the querent's typed question -- including
# the ones routed to the self-harm classifier -- so the free tier contradicts
# /privacy directly. The free limits (~15 req/min, 1000/day) would be adequate;
# the terms are not.
#
# Why gemini-3.5-flash-lite: docs/provider-comparison.md §§14-16. Best reader
# measured -- 0.036 reader overlap at matched length against z.ai's 0.061, a
# sentence ratio that holds by keeping Thessaly SHORT rather than by inflating
# everyone, and the first model to survive the blind read with its distinctive
# vocabulary swapped out. Two open caveats are recorded there: it produced one
# Malay word the eleven-word grep cannot catch (`memulakannya`, a morphological
# rather than lexical leak), and it streams in ~6 chunks against z.ai's 173,
# which nobody has yet judged on a real phone.
#
# THE RUNG BELOW IT is gpt-5.6-luna, and that one takes a FIFTH line:
#   LLM_PROVIDER=openai
#   LLM_MODEL=gpt-5.6-luna
#   MODERATION_MODEL=gpt-5.6-luna
#   OPENAI_REASONING_EFFORT=none    <-- NOT OPTIONAL
#
# **Without that fifth line luna returns roughly TWO BLANK READINGS IN NINE**,
# silently: reasoning tokens come out of the same budget as the prose, MAX_TOKENS
# here is 350-650, and the stream closes NORMALLY -- so the route records a
# completed reading, analytics records a success, no `[Bacaan terputus...]` fires,
# and the querent gets an empty page. It also 400s the moderation classifier,
# because `temperature: 0` is rejected while reasoning is on.
#
# The adapter REFUSES TO START on a gpt-5/gpt-6/o-series model with it unset,
# rather than trusting anyone to remember on the one bad day it matters. Any
# explicit value satisfies the check, including `low`: the rule is "you must have
# decided", not "you must disable reasoning". It is deliberately NOT required for
# Gemini, which was measured with no thinking overhead at these ceilings.
#
#   LLM_BASE_URL=                   # ANTHROPIC/z.ai ONLY. Not read by the OpenAI
#                                   # or Gemini paths; setting it there does nothing.
OPENAI_REASONING_EFFORT=none    <-- NOT OPTIONAL. See below.
#
#   LLM_BASE_URL=                   # LEAVE UNSET for OpenAI. It is Anthropic-only;
#                                   # the OpenAI adapter reads OPENAI_BASE_URL.
#
# **`OPENAI_REASONING_EFFORT=none` IS A HARD REQUIREMENT AND IT IS EASY TO LOSE.**
# Measured against the app's own nine Indonesian prompts. Without it:
#   - roughly TWO READINGS IN NINE COME BACK COMPLETELY BLANK. Reasoning tokens
#     are spent from the SAME budget as the prose, and MAX_TOKENS here is 350-650
#     because the length control is the product.
#   - Nothing reports it. The stream closes normally, so the route records a
#     completed reading, analytics records a success, no `[Bacaan terputus...]`
#     notice fires, and the querent simply gets an empty page.
#   - AND THE MODERATION CLASSIFIER 400s OUTRIGHT, because `temperature: 0` is
#     rejected while reasoning is on. That is a reasoning-MODE restriction, not a
#     model one: effort absent -> 400, `low` -> 400, `none` -> 200.
#
# The adapter REFUSES TO START on a gpt-5/gpt-6/o-series model with this unset,
# rather than trusting anyone to remember on the one bad day it matters. Setting
# it explicitly to anything -- including `low` -- satisfies that check: the rule
# is "you must have decided", not "you must disable reasoning".
#
# Why luna and not gpt-4.1-mini: docs/provider-comparison.md §13. It is the best
# of five OpenAI models measured, and it still does not reach z.ai's reader
# distinctness -- 0.079 overlap against 0.050 -- which is why this is the FALLBACK
# and not the default.
OPENAI_REASONING_EFFORT=                      # `none` for any gpt-5/o-series model.
                                              # Rejected by gpt-4.1 and gpt-4o --
                                              # leave it blank for those.
OPENAI_BASE_URL=                              # defaults to https://api.openai.com/v1.
                                              # Only for Azure or a gateway host.
LLM_BASE_URL=https://api.z.ai/api/anthropic
LLM_API_KEY=replace-me
# ── REASONING IS OFF AT THE ADAPTER, AND IT IS NOT A VARIABLE HERE ──────────
# On 2026-08-27 z.ai enabled reasoning-by-default for glm-4.6 and EVERY READING
# WENT BLANK, with nothing deployed for six days and nothing logged. Thinking
# tokens are spent from the SAME budget as the prose (MAX_TOKENS is 350-650), and
# anthropic.ts renders only `text` blocks -- so the reasoning ate the response and
# the querent got an empty page. The same call took the moderation classifier down
# with it, silently, failing OPEN.
#
# src/lib/llm/anthropic.ts now sends `thinking: {type:'disabled'}` on both call
# paths. There is deliberately NO env var for it: the only thing such a knob could
# do is turn every reading blank again at 2am. If you point LLM_MODEL at a model
# that NEEDS to reason, raise MAX_TOKENS in the same change and run the blind read.
#
# glm-5.3 (released 2026-08-14) reasons by default too -- switching to it WITHOUT
# the adapter fix would not have fixed anything. It is priced in prices.ts and is
# on the right side of the ~Feb-2027 plan cliff that glm-4.6 is not; the cutover is
# an env change, gated on `npm run smoke -- --all`'s blind read because it emitted
# markdown headings and an emoji into reader prose in testing.
LLM_MODEL=glm-4.6                             # glm-5.3 once the blind read passes.

# --- Auth (Google) ---------------------------------------------------------
# 32+ random bytes, base64. Also Auth.js's secret: it is the HKDF input for the
# key that encrypts the session JWE, so changing it signs everybody out.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# MUST BE SET IN VERCEL'S PREVIEW ENVIRONMENT AS WELL AS PRODUCTION. Missing it
# does not produce an error you can find: @auth/core returns a 500 whose body is
# a generic configuration message, next-auth correctly reads any non-OK response
# as "no session" so that auth fails closed, and the user-visible symptom is
# "sign-in appears to work, then every page bounces back to /login forever" with
# a 200 in the access log.
AUTH_SECRET=replace-me-with-32-plus-random-bytes-base64

# The base Auth.js builds its callback URL from, per environment.
#
# LOCAL IS :3001, NOT :3000. Port 3000 is permanently held by another project's
# Grafana container on this machine, so `npm run dev` always lands on 3001 --
# see CLAUDE.md's Traps. This is not cosmetic: a Google OAuth redirect URI is an
# exact-match string, so the URI registered in the Google console must be
# http://localhost:3001/api/auth/callback/google and nothing else.
#
# Preview: the STABLE VERCEL BRANCH ALIAS (jmtarot-git-<branch>-<scope>.vercel.app),
# read out of the dashboard rather than constructed -- branch names with slashes
# get mangled and a guess fails as redirect_uri_mismatch. Never the per-deployment
# URL, which changes every push and cannot be registered in advance.
#
# Production: https://www.jmtarot.site (reconciliation §7.2, amended
# 2026-07-27 -- it said .com, which was never bought). The apex 308-redirects to
# the www host; serve one host, never both, because the callback is a string
# comparison. Setting this to the apex is the mistake that looks harmless: the
# 308 lands the user on www, and Google refuses the apex redirect_uri you asked
# for.
AUTH_URL=http://localhost:3001

# Google Auth Platform -> Clients -> Create client -> Web application.
# The secret is shown once. Neither value contains a `$`, but the escaping rule
# below still applies to this file as a whole.
AUTH_GOOGLE_ID=replace-me.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=replace-me

# --- Session expiry --------------------------------------------------------
# Two numbers, and they are easy to conflate. Both are optional and both have
# working defaults; a missing, empty, zero, negative, non-numeric or absurd
# value falls back to the default rather than minting a session that expires
# immediately or in the year 3000 (src/lib/auth/ttl.ts).
#
# IDLE, and it SLIDES. Stop using the app for this long and you sign in again;
# any request resets it. Not a cap -- `session.updateAge` is ignored on the JWT
# path, so @auth/core re-issues the cookie on every session read, which includes
# every matched middleware invocation. Read at module scope in config.ts, which
# the edge bundle inlines, so changing it in the Vercel dashboard NEEDS A
# REDEPLOY to take effect for middleware.
#
# **168 SINCE 2026-07-30, AND IT WAS 24.** Roadmap D3 said one day; a returning
# querent met the landing page where they expected the reader picker, and the
# routing turned out to be correct -- what they hit was this timeout. One day is
# too short for an app somebody opens most days but not every day, and S-D5
# changed what expiry looks like: it used to be a `/login` form one tap from
# restored, and it is now a page addressed to a stranger.
#
# **THREE THINGS THIS BOUNDS BESIDES CONVENIENCE, so read before lowering OR
# raising it.** The full argument is in the header of src/lib/auth/ttl.ts.
#   1. A stolen cookie. SESSION_ABSOLUTE_TTL_DAYS below is still the only hard
#      bound; there is no server-side revocation on the JWT path.
#   2. ADMIN REVOCATION (A-D1/R38). requireAdmin() reads the session token, not
#      `users.deleted_at`, so demoting an admin is bounded by THIS value.
#   3. Erasure on a second device: DELETE /api/account clears only the cookie it
#      can see, and another browser's session lives until idle expiry.
# Do NOT raise it to 720 to match the cap -- the sliding window would then do no
# work at all and all three costs above would stretch to a month.
SESSION_TTL_HOURS=168

# ABSOLUTE, and it never slides. You sign in again after this long no matter
# what. This is the only thing that bounds a stolen cookie: JWT sessions have no
# server-side revocation, so a sliding session an attacker keeps warm would
# otherwise never expire. 0 or unset disables the cap, which is the escape hatch
# and not the intent.
SESSION_ABSOLUTE_TTL_DAYS=30

# --- Password login: LOCAL DEVELOPMENT ONLY --------------------------------
# `1` turns on a dev-only Credentials provider so local work and hardware
# testing do not need a Google round trip. It ALSO requires
# NODE_ENV !== 'production', which makes it inoperative in every Vercel
# deployment including previews -- those build as production. Never set it there.
#
# The provider produces a REAL Auth.js session against a real `users` row with
# google_sub = 'dev:<username>', so local development exercises the same code
# path production does. It is not a second cookie format; the old
# /api/auth/login route that minted one is deleted.
DEV_PASSWORD_LOGIN=

# One bcrypt hash per user, cost 12. LOCAL DEVELOPMENT ONLY after the switch to
# Google: it feeds DEV_PASSWORD_LOGIN above and nothing else.
# DELETE IT FROM VERCEL'S PRODUCTION AND PREVIEW ENVIRONMENTS -- a live password
# list in production for a route that no longer exists is the kind of thing that
# is embarrassing rather than dangerous right up until it is not.
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" 'the-password'
# Must be valid JSON on a single line. A malformed value fails closed (no
# logins) rather than open -- see src/lib/auth/users.ts.
#
# ESCAPE EVERY $ AS \$ IN THIS FILE AND IN .env.local. Next expands $VAR
# references when it loads a .env file, so a raw bcrypt hash has its `$2b` and
# `$12` substituted away as undefined variables and arrives mangled. The
# symptom is a 500 and "AUTH_USERS entry 0 must be..." on a hash that is
# demonstrably valid when you parse the same file by hand -- an hour of
# confusion for one backslash.
#
# This applies ONLY to .env files. Values set in the Vercel dashboard are
# literal, so paste the hash there with its dollars intact and NO backslashes.
AUTH_USERS=[{"u":"miftah","h":"\$2b\$12\$replace.me.with.a.real.bcrypt.hash.00000000000000000"},{"u":"jodith","h":"\$2b\$12\$replace.me.with.a.real.bcrypt.hash.00000000000000000"}]

# --- Database --------------------------------------------------------------
# Local Postgres 16 in Docker: `npm run db:up`. Production is Neon (roadmap D5,
# resolved 2026-07-27) and its value belongs in the Vercel dashboard, not here.
#
# Neon hands you TWO strings. Vercel gets the POOLED one, whose host contains
# `-pooler`. Everything that runs locally -- `db:migrate` against production,
# `db:studio`, `pg_dump` -- gets the DIRECT one. Pointing a local process at the
# pooled endpoint gives `prepared statement "s1" already exists`, because
# `client.ts` only disables prepared statements when `VERCEL` is set.
#
# The credentials below match docker-compose.yml, which commits them on
# purpose: the container binds to loopback and holds nothing but seeded
# fiction.
#
# The `$` trap above applies to this value too, and it bites differently: a
# password containing `$` is expanded away exactly like a bcrypt hash, and the
# symptom is a password-auth failure against a password that is demonstrably
# correct when you read this file yourself. `@ : / ?` additionally have to be
# percent-encoded, because they are URL syntax. Keeping the dev password
# alphanumeric means the question never arises.
DATABASE_URL=postgres://jmtarot:jmtarot@127.0.0.1:5432/jmtarot

# The integration suite (`npm run test:integration`) TRUNCATEs. This is a
# SEPARATE VARIABLE, never an override of DATABASE_URL, so that a forgotten
# flag or a shell without the override cannot point the test run at
# development data. The harness additionally refuses any value whose database
# name does not end in `_test`, which makes the mistake impossible rather than
# merely unlikely.
TEST_DATABASE_URL=postgres://jmtarot:jmtarot@127.0.0.1:5432/jmtarot_test

# REQUIRED ON VERCEL, Production AND Preview, or `npm run build` FAILS BY
# DESIGN -- `scripts/db-migrate-deploy.ts` runs first and refuses to skip when
# it cannot run, for the same defaulting reason as ANALYTICS_ENABLED. That
# guard exists because a committed migration nobody applied took production
# down on 2026-07-28 while the app looked perfectly healthy: sign-in and the
# language switch both died on one missing column, and neither symptom named a
# migration.
#
# Neon's DIRECT string, WITHOUT `-pooler`; the script refuses a pooled host,
# because pgbouncer in transaction mode does not reliably carry a migration's
# session state. DATABASE_URL above stays POOLED -- right for the runtime,
# wrong for DDL. Leave this unset locally: the script skips off-Vercel, keyed
# on `VERCEL` rather than NODE_ENV, because a preview build is also
# NODE_ENV=production.
MIGRATE_DATABASE_URL=

# --- Field encryption ------------------------------------------------------
# 32 bytes, for the AES-256-GCM encryption of the two most sensitive columns:
# onboarding_answers.answer_text and moderation_flags.question. Generate as
# base64url -- its alphabet is A-Za-z0-9-_ only, so there is no `+`, `/`, `=`
# or `$` to escape or quote anywhere (see the AUTH_USERS warning above for what
# a `$` does to a .env value):
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# A plain-base64 key also works -- Buffer decodes both alphabets -- it just
# needs escaping.
#
# LOSING THIS KEY DOES NOT BREAK THE APP: encrypted onboarding answers decrypt
# to NULL and read as "skipped", which roadmap §8 already requires the app to
# handle. It does mean that data is gone for good, and every affected read
# logs. Rotating it has the same effect: there is deliberately no re-encryption
# path, because building one before anyone has needed it means maintaining a
# migration for a hypothetical.
#
# Rotating it also makes historic moderation_flags.question_hmac values
# non-comparable, since that HMAC is keyed with this same value. That is
# acceptable; being surprised by it is not.
FIELD_ENCRYPTION_KEY=replace-me-with-32-random-bytes-base64url

# --- The Lotus distillation (W3) -------------------------------------------
# Both optional. Neither is needed for the app to run.

# The distillation is a different job from writing prose: it runs once per user
# rather than nine times a day, it produces JSON rather than a reading, and it
# may want a cheaper or a stricter model. Mirrors MODERATION_MODEL, and for the
# same reason. Unset falls back to LLM_MODEL, so nobody has to set it.
LOTUS_MODEL=

# `1` skips the model call entirely and writes the deterministic template
# instead, with no network at all. It exists because the distillation is the one
# part of onboarding that costs money to exercise, so the whole nine-step flow
# can be walked -- and its tests run -- with no LLM key.
#
# NEVER SET THIS IN PRODUCTION. It additionally requires NODE_ENV !== 'production'
# (same belt-and-braces as DEV_PASSWORD_LOGIN), so it is inoperative in any
# Vercel deployment even if it is set in the dashboard by accident -- but a
# production value here would mean every user silently gets the template instead
# of a distilled block, which is a degradation nothing would alert on.
LOTUS_STUB=

# --- Translation (V2) ------------------------------------------------------
# Optional, with a working default. A missing value here must never be the
# reason a translated reading does not render.

# Which model re-writes an existing reading in the other language. Unset falls
# back to LLM_MODEL, so nobody has to set it.
#
# THE SAME REASONING AS LOTUS_MODEL AND MODERATION_MODEL, and it points the
# opposite way from the classifier's: a translation is prose a person READS, in a
# reader's voice, with the word ceiling and the forbidden vocabulary re-enforced
# on it -- so it wants the READING model rather than a cheap one. Set it only if
# there is a measurement saying otherwise; `npm run smoke -- --translate` is how
# that measurement gets made.
#
# ESCAPE `$` AS `\$` IN THIS FILE. Next expands $VAR when loading a .env, which
# is the trap that mangles a bcrypt hash into nonsense. DO NOT ESCAPE IN THE
# VERCEL DASHBOARD -- values there are literal, and a backslash would become part
# of the model name.
TRANSLATION_MODEL=

# --- The Inner Heavenly Lotus persona (V8) ---------------------------------
# All three optional with working defaults. A missing value here must never be
# the reason `/account` does not render.

# Which model writes the persona. Unset falls back to LLM_MODEL.
#
# SAME REASONING AS TRANSLATION_MODEL AND THE OPPOSITE OF THE CLASSIFIER'S: a
# persona is prose a person reads about themselves and that V7 can make public,
# with the word ceiling and both forbidden lists re-enforced on it -- so it wants
# the READING model rather than a cheap one. `npm run smoke -- --persona` is how
# a different choice gets justified.
#
# ESCAPE `$` AS `\$` IN THIS FILE. Next expands $VAR when loading a .env, which
# is the trap that mangles a bcrypt hash into nonsense. DO NOT ESCAPE IN THE
# VERCEL DASHBOARD -- values there are literal.
PERSONA_MODEL=

# `1` skips the model call and writes the deterministic template, with no network
# at all. `/account` can then be walked, screenshotted and tested with no LLM key.
#
# NEVER SET THIS IN PRODUCTION, and it is LOTUS_STUB's exact reason: it
# additionally requires NODE_ENV !== 'production', so it is inoperative in any
# Vercel deployment even if the dashboard has it -- but a production value would
# mean every user silently gets the template, and nothing alerts on a fallback
# that is working as designed. `persona.generated.fallback` trending toward 1.0 is
# the metric that would show it.
PERSONA_STUB=

# The floor under regeneration, in seconds, checked on the READ path only.
#
# `personas.input_hash` covers the ids of the last ten readings, so it changes
# after EVERY draw -- which is the point (the persona moves as the querent reads)
# and is also a model call every time /account is opened after a reading. This
# bounds that.
#
# IT MUST NEVER GUARD A USER-CAUSED REGENERATION. A facts edit and a cleared
# answer both call `generatePersona` DIRECTLY, because a throttle on the reader is
# a latency decision while a throttle inside the generator is W3's swallowed
# answer-edit bug -- `input_hash` moved and `updated_at` frozen, which is the
# delete button being a lie.
#
# 3600 IS A GUESS AND NOT A MEASUREMENT. It decides how often a heavy user pays
# for a model call and it cannot be calibrated before there is a heavy user.
PERSONA_MIN_AGE_SECONDS=3600

# --- Analytics (W4) --------------------------------------------------------
# All four optional with working defaults. A missing analytics variable must
# never be the reason the app does not boot.

# `0` makes every write a no-op that logs at debug -- no events, no readings
# row, no last_seen touch. This is what lets `npm test` and `npm run smoke` run
# with no database at all; vitest.config.ts sets it to 0 for the unit project
# and src/lib/db/testing/harness.ts sets it back to 1 explicitly for the
# integration suite, which needs the opposite (reconciliation R20).
#
# UNSET MEANS ENABLED. Only the literal string '0' disables it, so a typo fails
# in the direction of collecting data rather than silently collecting none.
ANALYTICS_ENABLED=1

# `1` logs every event to the console as it is buffered, with its props. The dev
# loop for "is this firing at all?", and much faster than a psql round trip.
ANALYTICS_DEBUG=

# How long the after() callback waits for the reading stream to settle before
# persisting whatever arrived as `partial`. The tee's own cancel() handler
# catches an ordinary client disconnect in milliseconds, so this should never
# fire -- it exists because the alternative is an after() callback holding a
# paid invocation open until the platform kills it, taking the readings row
# with it.
ANALYTICS_STREAM_TIMEOUT_MS=45000

# Total wall-clock ceiling on the readings retry: three attempts at 0/250/1000ms
# plus jitter, and a wait that would exceed this budget is not started at all.
# Only the readings write is retried; events fail silently and log, because a
# dropped event is invisible and a missing readings row breaks a user-facing
# memory feature in W5.
ANALYTICS_RETRY_BUDGET_MS=5000

# --- Memory features (W5) --------------------------------------------------
# Per M15: kill switches and throttles are environment variables; product
# thresholds (FREQUENCY_GATE, VERDICT_LADDER, SUMMARY_MAX_WORDS) are typed
# constants in code, because a threshold change is a product change and belongs
# in a diff and in the smoke output. These three are the "it is misbehaving in
# production, turn it off" knobs, and those must not need a deploy.
#
# All three are optional with working defaults. As with the analytics block, a
# missing memory variable must never be the reason the app does not boot.

# How many past readings are recalled into a reading prompt.
#
# `0` IS THE KILL SWITCH for chained readings -- roadmap §10 names the forced
# callback ("as we saw yesterday..." in every single reading) as the risk most
# likely to destroy the effect the feature exists to create. If the
# chain_used/chain_offered ratio in the smoke output goes above roughly 60%,
# this is the lever that stops it today while the gate is retuned.
MEMORY_CHAIN_COUNT=2

# Nothing older than this is recalled. A callback to a reading from five weeks
# ago is not memory, it is surveillance.
MEMORY_CHAIN_LOOKBACK_DAYS=14

# The M13 regeneration throttle: at most one daily-summary generation per
# (user, reader, day, locale) per this many seconds. Stale-while-revalidate is
# deliberately NOT used here -- the moment the user is watching is right after a
# reading, and a summary that omits the reading they just did reads as
# forgetful, which is the one failure this feature cannot afford. Raise it if
# the model bill or the visible rewriting becomes a problem;
# `daily_summaries.generation_count` is how you tell whether it is set right.
SUMMARY_MIN_AGE_SECONDS=300

# --- Internationalization (W6) ---------------------------------------------
#
# Render the language toggle on the reader picker and the login page.
# RENDERING ONLY: it does not change the message key set, does not change the
# resolution order, and does not gate English behind a 404. An `en-GB` browser
# still gets English with the toggle hidden, because Accept-Language negotiation
# runs upstream of this flag.
#
# Only an explicit `0` disables it, so a typo shows the switcher rather than
# silently hiding a shipped feature -- the same defaulting rule as
# ANALYTICS_ENABLED, pointed the same way: the quiet failure is the one nobody
# notices. Remember the `\$` escaping rule at the top of this file for any value
# you add here; this one has no `$`, but the next person copying the block will
# not know that.
#
# v0.4.0 (S2): THE SCOPE GREW AND THE VARIABLE DID NOT. It still decides only
# whether the CONTROL renders, in three places now -- the login footer, the
# account menu, and `ContentLocaleLink` in the public footer. On a public content
# route English lives at `/en/...` regardless, and the `hreflang` set NAMES that
# URL to a crawler whatever the UI offers, so `LOCALE_SWITCHER=0` no longer hides
# English from anybody except a person looking for a button. That is the intended
# reading of "RENDERING ONLY", now load-bearing rather than incidental.
LOCALE_SWITCHER=1

# --- The public surface (v0.4.0 / S-D11) ------------------------------------
# The canonical origin, e.g. https://www.jmtarot.site . Falls back to AUTH_URL's
# ORIGIN, then VERCEL_PROJECT_PRODUCTION_URL, then VERCEL_URL, then
# http://localhost:3001.
#
# ABSENT IS FINE LOCALLY AND WRONG IN PRODUCTION: a canonical tag pointing at a
# preview host DE-INDEXES THE REAL PAGE, and NOTHING REPORTS IT. The check is one
# curl and it is in docs/DEPLOY-VERCEL.md §7a.
#
# On a PREVIEW, leave it unset or set it to the preview host -- never to
# production. A preview emitting production canonicals asks Google to index a URL
# the page is not at.
#
# THE `NEXT_PUBLIC_` PREFIX IN THIS NAME IS MISLEADING AND IS KEPT ANYWAY (R10).
# `siteOrigin()` is STILL server-only in practice: the other three rungs carry no
# prefix, so in a browser bundle they inline as `undefined` and the chain collapses
# to localhost. A client component is handed a finished URL as a prop -- see
# `PublicShare`. Two fences hold it: `clientBoundary.test.ts` on the direct import
# and `scripts/audit-secrets.ts`'s TRANSITIVE walk. It is also the ONLY
# `NEXT_PUBLIC_` variable this project declares, and the tripwire's allowlist pairs
# it with its one legitimate reader (`src/lib/seo/origin.ts`) rather than with the
# whole tree.
NEXT_PUBLIC_SITE_ORIGIN=

# --- Sharing (V7) -----------------------------------------------------------
# Two variables, both optional, and NEITHER CONTAINS A `$` -- but remember the
# `\$` escaping rule at the top of this file for anything you add beside them,
# and remember that values in the VERCEL DASHBOARD are literal and must NOT be
# escaped.

# Whether a share link can be MINTED. `!== '0'`, so only an explicit `0` turns it
# off and a typo leaves the feature on -- ANALYTICS_ENABLED's rule, pointed the
# same way, because the quiet failure is the one nobody notices.
#
# **IT GATES MINTING ONLY. EXISTING LINKS KEEP RESOLVING.** A kill switch that
# breaks links people have already sent is worse than the thing it is switching
# off: a stranger meets a dead page and blames the friend who sent it. If links
# must actually go dark, the honest tool is
# `update share_links set revoked_at = now()`, which somebody decides on purpose
# and which leaves the rows revoked rather than resurrectable.
SHARING_ENABLED=1

# The origin a share URL is built against. **UNSET IN PRODUCTION**, where
# `AUTH_URL` is already `https://www.jmtarot.site` and one host is the rule --
# the apex 308-redirects to `www`, and an OAuth redirect URI is a string
# comparison. Set it ONLY if the share host ever differs from the app host.
#
# `AUTH_URL`'s ORIGIN is used, not its string: it is allowed to carry a path, and
# a share URL built by concatenation would come out as `.../some/path/s/<slug>`.
# Unset locally it falls back to `http://localhost:3001`, which is the dev origin
# because port 3000 is permanently held by another project's Grafana.
#
# **SET IT WHEN YOU RUN THE DEV SERVER ON ANY OTHER PORT.** The OG image
# references the card art by ABSOLUTE URL, so a mismatch makes satori log
# `Can't load image ... fetch failed` and return a 200 with the layout and no
# pictures -- 65KB instead of 387KB, and no error anywhere.
SHARE_BASE_URL=

# --- Moderation, terms and retention (W7) ----------------------------------
# Six variables. Five are optional with working defaults; MODERATION_MODEL is
# not, and the reason is measured rather than asserted -- see below.

# The classifier's model. MEASURED 2026-07-27 with `npm run probe:moderation`,
# and this is the one moderation variable that is a PRODUCTION REQUIREMENT
# rather than a default worth overriding:
#
#   glm-4.6        p50 1764ms  p95 7546ms     <- the reading model. TOO SLOW.
#   glm-4.5-air    p50 1812ms  p95 4600ms
#   glm-4.5-flash  p50  617ms  p95  903ms     <- this one
#
#   the reading's own time-to-first-token, same session:  p50 4591ms
#
# D8's whole premise is that the classifier returns BEFORE the reading's first
# token, so the gate adds no latency anyone can feel. On glm-4.6 the p95 is
# nearly TWICE the reading's p50 TTFT and the gate becomes the latency. Leaving
# this unset falls back to LLM_MODEL and silently reintroduces exactly that.
# Re-run the probe before changing it; the measurement picks the model.
MODERATION_MODEL=glm-4.5-flash

# How long the gate waits for the classifier. A BACKSTOP FOR A HUNG CALL, NOT A
# TARGET -- p95 on the model above is 903ms, so this is ~1.7x the tail and still
# a third of the reading's TTFT. What happens on expiry is asymmetric and is the
# whole of W7-D7: a CLEAN blocklist fails OPEN (the reading proceeds), a Tier-B
# SUSPECT fails CLOSED (refused as `unclear`). Flat fail-closed would refuse
# every user's question about their job during a provider hiccup, with an
# accusation attached; flat fail-open is a bypass anyone can induce.
MODERATION_TIMEOUT_MS=1500

# The kill switch, named so it CANNOT be misread as "moderation off": `0` runs
# the blocklist only and logs a warning on every request. The blocklist is still
# terminal on a Tier-A hit. It exists because the alternative, when the
# classifier provider breaks at 2am, is a deploy.
#
# Only an explicit `0` disables, same defaulting rule as ANALYTICS_ENABLED.
MODERATION_CLASSIFIER_ENABLED=1

# How long moderation_flags.question is kept before it is nulled and
# redacted_at is stamped. The ROW is kept forever -- category, source,
# confidence, locale, timestamp are the tuning signal and are not personal data
# once the text is gone. Thirty days is long enough to read a week of false
# positives with a lag and short enough to state in a privacy policy without
# embarrassment. The privacy policy states this number; changing it here without
# changing it there makes the policy a lie.
#
# `sexual_minor` NEVER stores the text at all, at any retention. And the text is
# encrypted at rest with FIELD_ENCRYPTION_KEY on the way in (reconciliation
# R15), so this is a second control rather than the only one.
MODERATION_QUESTION_RETENTION_DAYS=30

# Compared against users.terms_version. A BUMP FORCES RE-ACCEPTANCE for every
# existing user, so change it only for a material change to /terms -- a typo fix
# is not one. Date-shaped so the version and the day it shipped are the same
# fact.
TERMS_VERSION=2026-07-27

# The analytics TTL (reconciliation §7.9b), swept by the daily cron job.
# `readings` is deliberately NOT on this clock: it is kept for the life of the
# account because every memory feature reads it, and the privacy policy says
# both of those things in those words.
EVENTS_RETENTION_DAYS=180

# The llm_calls ledger TTL, swept LAST by the same daily cron job (A3, v0.5.0,
# reconciliation R19). The FIFTH delete in that job -- not a fifth job.
#
# NOT 180, AND THE DIFFERENCE BETWEEN THE TWO TABLES IS THE ARGUMENT. `events` is
# a behavioural firehose whose value decays in weeks and which the privacy policy
# commits to deleting. `llm_calls` is a COST LEDGER, it holds no querent text at
# all, and the one question it exists to answer -- "what did this cost, and is
# that growing" -- needs a year-over-year comparison to be answerable at all.
#
# 400 IS NOT ARBITRARY: it is HISTORY_DAY_LIMIT's number and series.ts's
# MAX_RANGE_DAYS. The retention window and the maximum queryable range are the
# same number on purpose, so the dashboard can never offer a range whose data was
# already swept -- which would look like a bug in the chart rather than like a
# retention policy. Three constants that must agree, agreeing.
#
# THE BINDING INPUT IS NEON FREE'S 0.5 GB, not a row rate that does not exist
# yet. At ~450 B/row all-in (five indexes roughly double a ~200 B heap tuple),
# 400 days at 1,000 calls/day is ~400k rows ~= 180 MB, 36% of the plan; at a
# realistic early 50/day it is ~9 MB. The sweep logs a `[llm_calls] rows= bytes=`
# line EVERY night so the missing measurement starts existing; revisit at 100 MB
# or 25% of the plan's storage, whichever comes first.
#
# A BLANK VALUE IS NOT ZERO DAYS. `Number('')` is 0, so the parser tests
# `Number.isFinite(raw) && raw > 0` -- both halves -- because
# `make_interval(days => 0)` would empty the ledger on the first run at 03:17,
# silently. Unset is the normal state; this line documents the default.
#
# admin_access_log IS NEVER SWEPT and has no variable here. An audit trail with a
# delete path is the audit trail's absence (roadmap §9.14), and /privacy clause
# 6's row for it reads "kept indefinitely" because that is the honest one.
# LLM_CALLS_RETENTION_DAYS=400

# The shared secret Vercel Cron presents on its daily calls. Vercel sends it as
# `Authorization: Bearer <value>`. Generate with:  openssl rand -base64 32
#
# WITHOUT THIS SET BOTH ROUTES 503 RATHER THAN RUNNING UNAUTHENTICATED. An open
# endpoint that deletes rows is worse than a sweep that never runs, and a sweep
# that never runs is visible in the data within a month.
#
# ONE SECRET FOR BOTH JOBS (v0.7.0, F5). /api/cron/nudge shares it, and the
# argument is the sweep's own: a second secret is a second thing to rotate, a
# second thing to have unset, and a second 503 nobody recognises. The nudge does
# not delete anything -- it WRITES ROWS INTO OTHER PEOPLE'S CHAT ROOMS and fans
# out over every user, so an open version of it is a way to make the app message
# everybody.
#
# `x-vercel-cron-schedule` is NOT an authorisation signal on either route. It is
# a header any caller can set.
CRON_SECRET=replace-me-with-32-random-bytes-base64

# --- V9: the distributed rate limiter -------------------------------------

# Upstash Redis, REST. Both or neither: with either missing, every limiter runs
# on the per-instance in-memory windows -- which is what v0.2.0 shipped, so a
# local dev environment needs no account and `npm test` needs no network.
#
# WITHOUT THEM IN PRODUCTION THE LIMITER SILENTLY REVERTS to per-instance
# memory. The app looks completely healthy and every stated limit is quietly
# multiplied by the number of warm instances. `docs/DEPLOY-VERCEL.md` §2b.
#
# ESCAPE `$` AS `\$` HERE. Do NOT escape in the Vercel dashboard, where values
# are literal. Same trap that mangles a bcrypt hash and a DATABASE_URL
# password, and an Upstash token is long, opaque and impossible to eyeball for a
# missing character -- the symptom is a limiter that is silently 100% degraded,
# because a bad token is an error and an error falls back to memory. Verify with
# the `vercel env pull` recipe in DEPLOY-VERCEL.md §2, not by reading the
# dashboard.
#
# PICK `ap-southeast-1` (SINGAPORE) -- THE SAME REGION AS THE FUNCTIONS.
#
# **THIS COMMENT SAID "THERE IS NO SINGAPORE REGION (verified 2026-07-27)" AND
# THAT WAS WRONG.** Production's database is `ap-southeast-1`, Global tier, read
# straight off the Upstash console on 2026-07-29. Inverted rather than deleted,
# because the false claim was repeated in five places and shaped two decisions.
#
# Same region as `sin1` and as Neon, so the round trip is intra-region rather
# than the ~80-120ms Tokyo hop this file used to predict. NOBODY HAS MEASURED THE
# REAL FIGURE YET -- expect single-digit to low-double-digit ms, and do not quote
# a number here until someone has one from a warm function.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# The 2am kill switch. `memory` forces every budget local, fleet-wide
# enforcement included. Same shape and same reason as
# MODERATION_CLASSIFIER_ENABLED: when the limiter is the thing that is broken,
# the alternative should not be a deploy.
#
# NOTE THE DEFAULTING RULE IS THE OPPOSITE OF ANALYTICS_ENABLED'S, on purpose.
# There, a typo must over-collect. Here, a typo must not silently disable
# enforcement -- so only the exact string `memory` does anything, and anything
# else (including a typo) leaves Redis on.
RATELIMIT_BACKEND=

# How long a limiter may take before we stop waiting and answer from memory.
# NOT a target, and the margin is now far wider than this line used to claim: it
# said "from Singapore to the Tokyo region is ~80-120ms". The database is in
# Singapore, the same region as the function, so the expected value is much
# smaller and unmeasured. 1000ms exists only to bound a HUNG fetch. Same kind of
# number as MODERATION_TIMEOUT_MS.
RATELIMIT_TIMEOUT_MS=1000

# The crowd ceiling, per hour, FLEET-WIDE. 400 in v0.2.0 meant 400 per warm
# instance; 1200 is roughly that against three. A burst guard -- the real bound
# is LLM_WINDOW_CALL_CEILING below.
RATELIMIT_GLOBAL_HOURLY=1200

# `redis` moves /api/events onto the shared limiter. Left unset it stays on
# per-instance memory, deliberately: it is the highest-volume and lowest-value
# budget in the app, and letting one browser tab dominate the limiter's own
# command budget is the failure mode the limiter exists to prevent.
RATELIMIT_EVENTS_BACKEND=

# `redis` moves the SESSION-UPDATE budget onto Upstash. Leave it unset.
#
# THIS ONE IS ON MEMORY FOR LATENCY, NOT FOR COST, which is why it has its own
# variable rather than sharing the one above. `auth.ts`'s jwt update branch
# spends one `hit()` before it re-reads the row, and every caller of
# `refreshSession()` pays it -- including `POST /api/locale`, on the request path
# of a language switch.
#
# **THE LATENCY HALF OF THIS ARGUMENT HAS EXPIRED.** It said "Upstash has no
# Singapore region (verified 2026-07-27), so on Redis that is a `sin1`->Tokyo
# round trip inserted between a database write and a database read". The region
# is Singapore, so that round trip is intra-region. The decision still stands on
# the paragraph below -- which was always the stronger half -- but anybody moving
# this budget onto Redis should MEASURE rather than cite the sentence above.
#
# The budget loses nothing real by being per-instance: it stops ONE
# authenticated user spinning database reads by spamming POST /api/auth/session,
# and one user's requests land mostly on one warm instance. Contrast the
# fleet-wide budgets, which are meaningless per-instance.
#
# Symptom that made this necessary: on iPhone Safari the language toggle appeared
# to do nothing, because the client abandons at 6s while the write landed anyway.
RATELIMIT_SESSION_BACKEND=

# --- V9: the global model-call ceiling ------------------------------------

# **THIS REPLACES THE Z.AI SPEND CAP, WHICH DOES NOT EXIST ON A SUBSCRIPTION.**
# LLM_API_KEY is a fixed annual plan, so abuse does not produce a bill -- it
# produces an exhausted quota, which is a denial of service against the querent
# with no billing alert to notice it by.
#
# Counts MODEL CALLS, not readings: one visit can be six (classifier, reading,
# gist, day summary, frequency verdict, translation).
#
# A ROLLING FIVE-HOUR WINDOW, NOT A CALENDAR DAY, because that is the shape of
# the quota it protects: z.ai meters prompts per rolling 5-hour cycle (verified
# 2026-07-27). A daily bucket could not do the job -- a script burns the whole
# cycle in five minutes while a daily counter still reads 400/4000.
#
# 280 = the Pro tier's ~400 prompts per 5h x 70%. The headroom is deliberate:
# we could not observe what exhaustion looks like on the wire without causing
# it. IF THE PLAN TIER CHANGES, re-derive this AND re-check the weekly
# arithmetic in meter.ts's header -- 280/5h is 1344/week against a ~2000 weekly
# quota, so the 5-hour ceiling holds the weekly one only at Pro.
#
# **RE-DERIVED 2026-08-07 FOR v0.7.0's GROUP CHAT. UNCHANGED AT 280.** `C-D6`
# required the exercise before the chat shipped, and "re-derived and unchanged"
# is a real outcome of it rather than a skipped task. Three facts, all pointing
# the same way:
#
#   1. **A BIGGER NUMBER DOES NOT CREATE QUOTA.** The denominator is a property
#      of the plan, not of the app. Raising 280 raises what this app is willing
#      to spend, not what z.ai will serve.
#   2. **THE BALANCE ON THE ACCOUNT IS ZERO** (read 2026-08-01), so there is no
#      soft landing: the failure past the plan's limits is `1113 Insufficient
#      Balance` on the FIRST call, instantly, for everybody. A ceiling sitting
#      closer to the provider's own limit converts a graceful internal refusal
#      into a provider-side outage.
#   3. The right instrument for "the chat multiplies calls 5-10x" is
#      LLM_WINDOW_CHAT_CEILING below, plus `callClass: 'deferred'` on both chat
#      call sites. All three exist so this number does not have to move.
#
# **WHAT DOES CHANGE IT: ~FEBRUARY 2027.** On the credit-metered plan CLAUDE.md's
# `## The z.ai plan` describes, 280 loses its units entirely -- a four-paragraph
# spread3 and a one-line classifier reply stop being one unit each, and at a 24x
# output multiplier they are very far apart. RE-DERIVE AGAINST CREDITS THEN.
LLM_WINDOW_CALL_CEILING=280

# The soft tier. Below it, everything runs. Above it, DEFERRED work is shed --
# gists, day summaries, frequency verdicts, the speculative Lotus refresh -- and
# a querent notices nothing except a slightly less specific reading. Defaults to
# 70% of the hard ceiling.
LLM_WINDOW_CALL_SOFT=

# The local `serverless-redis-http` from docker-compose.yml, which speaks
# Upstash's REST protocol against a real Redis. `npm run test:integration`
# SKIPS the redis suite when this is absent, so somebody on an older compose
# file still gets a green run rather than a red one for a service they do not
# have. Needs no Upstash account and no network.
#
# The token is fixed and trivial on purpose, exactly like the postgres password:
# it binds to loopback and holds nothing but counters that expire within the
# hour. NEVER reuse it for anything.
TEST_UPSTASH_REDIS_REST_URL=http://127.0.0.1:8079
TEST_UPSTASH_REDIS_REST_TOKEN=jmtarot-test-token

# --- The five model-call kill switches (2026-07-30) -------------------------

# **THE DELIBERATE COUNTERPART TO LLM_WINDOW_CALL_CEILING ABOVE.** That one is
# involuntary and shed by call class; these five are an operator's decision, taken
# when the quota is going and something has to give. `src/lib/llm/flags.ts` holds
# them, beside the meter and the ledger, and `docs/DEPLOY-VERCEL.md` §2d is the
# runbook -- including which one to reach for first.
#
# **ONLY THE EXACT STRING `0` DISABLES.** ANALYTICS_ENABLED's rule, and note it is
# the OPPOSITE of RATELIMIT_BACKEND's: there a typo must not disable enforcement,
# here a typo must not silently cost every querent a feature. `false`, `off`, `no`
# and an empty value all mean ENABLED.
#
# **WHICH IS WHY ALL FIVE ARE SET TO `1` ON VERCEL, in Production AND Preview,
# rather than left unset** (2026-07-30). Unset behaves identically, so the value is
# not what the rows are for -- being FINDABLE is. `1` on screen makes the obvious
# opposite `0`, the one value that works; a row reading `true` would invite `false`,
# which does nothing and reports nothing. Edit in place, never add-and-delete, and
# REDEPLOY after a change -- Vercel injects these at build time, so a `0` does not
# reach a lambda that is already running.
#
# **THE READING AND THE TRANSLATION HAVE NO SWITCH AND MUST NEVER GET ONE**
# (Miftah's ruling). A reading is the product; a translation is what stops an
# English querent being shown Indonesian prose, which is the bug V2 exists to
# prevent. Switching either off does not degrade JMTarot, it ends it -- so the
# honest tool there is a maintenance page. `flagCoverage.test.ts` asserts the
# absence by name, and asserts that no NEW model call site can appear without
# being either flagged here or exempted with a written reason.
#
# The moderation classifier is absent for the opposite reason: it already has
# MODERATION_CLASSIFIER_ENABLED, above, named there so it cannot be misread as
# "moderation off".
#
# **EVERY ONE OF THESE GATES THE MODEL CALL AND NOT THE CACHED READ**, following
# SHARING_ENABLED's rule: a querent who already has a verdict, a summary or a
# persona keeps seeing it, for free, out of the row that is already there. Off
# means "write nothing new", never "hide what exists".
#
# LISTED CHEAPEST BLAST RADIUS LAST -- i.e. reach for GIST_ENABLED FIRST. It is
# one call per READING, so it is the only one whose volume tracks reading count
# rather than user count or day count, and it is worth more than the other four
# together.

# ONE CALL PER READING, and the biggest single reduction available short of
# switching readings off. Off: `readings.gist` stays null and those readings are
# excluded from recall -- so a later reading will never call back to one taken
# while this was off, PERMANENTLY, because nothing backfills. That cost was
# offered and accepted; it is the price of the largest lever.
GIST_ENABLED=1

# The card-frequency line under "Pilih pembaca yang cocok denganmu" on the reader
# picker -- the thing that reads as a weekly summary. NOT named WEEKLY, because
# `week` is only the first of eight windows it walks (d3, d13, d666, month,
# quarter, year, birthday). Off: a cached line still serves; otherwise 204, and
# FrequencyLine renders nothing at all, which is already the state most querents
# are in on most days. Nothing on the picker moves.
FREQUENCY_VERDICT_ENABLED=1

# Today's summary on the second swipe panel of /[reader]. Off: a cached summary
# still serves; otherwise 204, and the deck is one panel exactly as tall as the
# bio, with no dots -- V5's M14 contract and the state of every querent who has
# not read today.
DAILY_SUMMARY_ENABLED=1

# The four-sentence persona on /account. NAMED _GENERATION_ because with it off
# the BLOCK STILL RENDERS, from the stored paragraph or from the deterministic
# template; a bare PERSONA_ENABLED would read as "the block disappears".
#
# Off: an existing paragraph is NEVER overwritten with a template -- the /account
# read path regenerates in an after(), so that guard is the whole difference
# between a kill switch and a data-degrading one. A querent with no row yet does
# get the template, because /api/persona's no-row branch 500s otherwise. It is
# replaced with a real one on their next reading, which moves the input hash.
PERSONA_GENERATION_ENABLED=1

# The Lotus distillation -- read into EVERY reading prompt, so this is the widest
# blast radius here: a querent who onboards while it is off is read by an
# un-personalised reader. Reach for it LAST.
#
# **NOT LOTUS_STUB, WHICH MUST STILL NEVER BE SET IN PRODUCTION.** That variable
# stores the template under the current input_hash, and `lotusInputHash` digests
# only the birth year and the six answers -- so it NEVER MOVES AGAIN and the
# template becomes permanent even after the variable is removed. This flag writes
# NOTHING instead: `getLotusBlock` returns null, the reading path already treats
# null as normal, and the next reading after it goes back to 1 distils for real.
# `lotus.generate.integration.test.ts` is the regression test for exactly that.
LOTUS_GENERATION_ENABLED=1

# --- v0.5.0: the admin surface (A1) -------------------------------------------

# WHO CAN SEE /admin. Comma-separated email addresses. **UNSET OR EMPTY MEANS
# NOBODY**, and that direction is chosen (A-D1, roadmap §8).
#
# NOTE THE DEFAULTING RULE IS THE OPPOSITE OF ANALYTICS_ENABLED'S and the SAME AS
# RATELIMIT_BACKEND'S. There, a typo must over-collect. Here, a typo must not open
# a door -- so `ADMIN_EMAILS=`, `ADMIN_EMAILS=,` and a misspelt variable name all
# mean the same thing: the dashboard exists and nobody can reach it. There is no
# input for which the parser gives up and admits everyone.
#
# Trimmed, lowercased, de-duplicated, and compared without an early exit
# (src/lib/admin/allowlist.ts). **EXACT, which means Gmail dots and plus-addressing
# are NOT normalised**: `a.b@gmail.com` and `ab@gmail.com` are the same Google
# mailbox and are NOT the same entry here, because normalising them would make the
# allowlist match an address nobody wrote in it. Write the address you actually
# sign in with.
#
# **PRODUCTION ONLY. DO NOT SET IT ON PREVIEW** (reconciliation R37, and it is a
# ruling nobody had made until v0.5.0 was reconciled). Preview shares DATABASE_URL
# with production, so setting this there gives EVERY push-triggered preview URL a
# live admin surface over real querent data -- on a URL that is shared in PR
# comments and is in nobody's threat model. The gate is the same gate, so this is
# not an authorisation hole; it is a surface-area increase nobody chose.
#   Loop 5 therefore runs the signed-in admin flow against
#   E2E_BASE=http://localhost:3001, and runs the signed-out and non-admin refusal
#   cases against production -- which need no admin identity and are the half that
#   actually needs a real deployment.
# docs/DEPLOY-VERCEL.md §6a repeats this, because a variable whose correct value
# differs per environment is exactly the class that file exists for.
#
# **EMAIL IS NOT THE IDENTITY -- `google_sub` IS** (schema.ts). If the operator's
# Google email changes they lose access until this variable changes. Fail-closed,
# and correct. Do NOT "fix" it by matching on `users.id`, which would put a uuid in
# an env var nobody can read or verify.
#
# **REVOCATION IS A REDEPLOY.** There is no server-side revocation on the JWT path,
# so demoting an admin means changing this value and shipping. Accepted: there is
# one admin. And the sentence A-D1 does not say (R38) -- **deleting the admin's own
# account is not revocation either**, because requireAdmin() reads the session token
# and not `users.deleted_at`; the bound is SESSION_TTL_HOURS.
#
# **IF /admin REDIRECTS YOU TO /onboarding, THE ALLOWLIST IS PROBABLY FINE** (R34).
# The middleware chain bounces a signed-in, un-onboarded user to /onboarding above
# any admin check, so a fresh admin account presents exactly like a misspelt entry
# here. Finish onboarding once and it goes away. Not fixed on purpose: exempting
# /admin would mean the onboarding chain acquiring a special case, which S-D5 spent
# a release arguing against.
#
# NEEDS NO `$` ESCAPING (no email contains one), and the rule sits here anyway
# because the variables around it do: escape `$` as `\$` in a .env file, and do NOT
# escape in the Vercel dashboard, where values are literal.
#
# **NOT `NEXT_PUBLIC_`, and it must never become so.** NEXT_PUBLIC_SITE_ORIGIN
# remains the only NEXT_PUBLIC_ variable this project declares, and an operator's
# email address inlined into a client bundle is the one field `toViewer()` drops
# from every session for exactly this reason. It is in `SECRET_ENV` in
# scripts/audit-secrets.ts, so the build greps the client bundle for its value.
#
# There is deliberately NO `ADMIN_ENABLED` kill switch (roadmap §8): an empty
# ADMIN_EMAILS is the kill switch, and a second mechanism is a second thing to get
# wrong. And no price variable -- prices are a committed constant (A-D7), because a
# price in an env var is a number with no history and no review.
#
# A2's and A3's variables are theirs to document, and A3's has now arrived:
# LLM_CALLS_RETENTION_DAYS is annotated in full beside EVENTS_RETENTION_DAYS, where
# somebody comparing two retention windows will actually be looking.
ADMIN_EMAILS=

# WHICH MODEL THE WHOLE ADMIN SURFACE CALLS. Unset falls back to LLM_MODEL, so
# nobody has to set it. src/lib/admin/model.ts. Added 2026-08-01, Miftah's ruling.
#
# ONE VARIABLE FOR THREE CALL SITES, ON PURPOSE. The Insight button
# (src/lib/admin/insight.ts), Auto Format (blogFormat.ts) and Terjemahkan otomatis
# (blogAutoTranslate.ts) are the only model calls in this app whose caller is the
# operator rather than a querent, and flagCoverage.test.ts already treats them as
# one class. Three variables would be three chances for one dashboard to answer in
# two different voices, and nobody would notice which button was on which model.
#
# IT POINTS AWAY FROM THE READING MODEL, WHICH IS THE OPPOSITE OF WHAT
# TRANSLATION_MODEL AND PERSONA_MODEL DO. Those two exist to keep prose a person
# reads in a reader's voice. Nothing here is in a reader's voice: the Insight
# button reads a table of numbers and Auto Format returns JSON metadata. Reading a
# table well and writing a tarot reading well are different jobs, and the admin
# surface is the ONE place in this app where a model change cannot reach a querent
# -- so it is the cheapest place to run something else, and the safest place to
# try something new.
#
# THERE IS NO PRICE ROW FOR THIS MODEL UNLESS SOMEBODY ADDS ONE. src/lib/llm/prices.ts
# is hand-maintained and an unknown model prices as `null`, never 0 -- so
# /admin/tokens will count these calls as UNPRICED until a human opens the provider's
# pricing page and adds a row with a real `verifiedOn`. That is the honest empty state
# that file was built around, not a bug. It costs nothing today: every z.ai row is
# zero because the Coding Plan is a subscription.
#
# ESCAPE `$` AS `\$` IN THIS FILE. Next expands $VAR when loading a .env. DO NOT
# ESCAPE IN THE VERCEL DASHBOARD -- values there are literal, and a backslash would
# become part of the model name.
#
# SET IT ON PRODUCTION *AND* PREVIEW, unlike ADMIN_EMAILS above. That variable is
# production-only because it opens a door; this one only chooses a model, and a
# preview deployment running a different model from production is a difference
# nobody would think to look for while debugging the thing they pushed.
ADMIN_MODEL=glm-5.2                            # glm-5.3 is a drop-in; see prices.ts.

# --- v0.7.0: the group chat -----------------------------------------------

# WHICH MODEL THE ROOM RUNS ON -- the director AND all three voices (`C-D4`,
# Miftah's ruling: "i would like you to set the LLM for the chat group (planner
# and readers) to be GLM 5.2. the best model we have").
#
# It follows ADMIN_MODEL's shape and points the same way -- AWAY from LLM_MODEL,
# toward the better model -- BUT FOR THE OPPOSITE REASON. ADMIN_MODEL points away
# because nothing on that surface is in a reader's voice; this points away because
# EVERYTHING on this surface is.
#
# ONE VARIABLE FOR THE DIRECTOR AND THE VOICES, ADMIN_MODEL's precedent. A
# CHAT_PLANNER_MODEL would be a fourth model variable whose only effect is to let
# somebody make the director dumber than the readers it is directing, at 2am, and
# never notice. If measurement later shows the director is fine on a cheaper model,
# that is a NEW variable with a measurement behind it.
#
# UNSET FALLS BACK TO LLM_MODEL, so the four-variable Gemini emergency fallback
# covers the chat with no fifth variable to remember.
#
# glm-5.2 IS ALREADY CALLED IN PRODUCTION (ADMIN_MODEL) and prices.ts carries a row
# for it, verified 2026-08-01 -- so the chat is priced from day one. It is also, by
# accident, on the RIGHT side of the ~February 2027 line that LLM_MODEL=glm-4.6 is
# on the wrong side of: the current plan's supported set is GLM-5.2, GLM-5-Turbo
# and GLM-4.7. Read CLAUDE.md's `## The z.ai plan` before touching a price because
# of this.
#
# RUN `npm run probe:usage` AFTER THIS LANDS. It is a model change, and this repo
# has been wrong about what a provider reports for a whole release before.
#
# ESCAPE `$` AS `\$` IN THIS FILE; DO NOT ESCAPE IN THE VERCEL DASHBOARD. SET IT ON
# PRODUCTION *AND* PREVIEW, for ADMIN_MODEL's reason.
CHAT_MODEL=glm-5.2                             # glm-5.3 is a drop-in; see prices.ts.

# THE CHAT'S GENERATION KILL SWITCH. Only the exact string `0` disables; `false`,
# `off`, `no` and `""` all mean ENABLED, so a typo cannot silently cost every
# querent the feature.
#
# OFF: THE ROOM STILL OPENS AND EVERY PAST MESSAGE STILL RENDERS. Only the director
# and the voices decline; `GET /api/chat/messages` is untouched, `/api/chat/state`
# reports `chatEnabled: false`, and the composer is disabled with one line of copy.
# A KILL SWITCH THAT BLANKS A SCREEN IS A WORSE OUTAGE THAN THE QUOTA IT PROTECTS.
#
# It is SELF-HEALING, on the Lotus's side of flags.ts's asymmetry rather than the
# persona's: nothing is written, so there is no stored artifact whose hash would
# freeze, and a run left `pending` is picked up the moment this returns to `1`. A
# message the querent POSTED is still stored while it is off -- off means "write
# nothing new", and a querent's own words are not new generation.
#
# `1` rather than unset, for the reason the five older flags are: unset behaves
# identically, so the value is not what the row is for -- BEING FINDABLE IS.
CHAT_ENABLED=1

# UNPROMPTED RUNS ONLY. A posted message still gets answered.
#
# **THIS IS THE FLAG AN OPERATOR SHOULD REACH FOR FIRST**, because proactive runs
# are the ones with no human waiting and therefore the cheapest thing in the app to
# lose. It gates a MINT rather than a model call, which is why
# flagCoverage.test.ts has a third table for it.
CHAT_PROACTIVE_ENABLED=1

# ── The profile memory (R2) ─────────────────────────────────────────────────

# WHAT THE ROOM REMEMBERS ABOUT A QUERENT. One model call per completed chat run
# whose transcript has moved past PROFILE_MEMORY_MIN_AGE_SECONDS.
#
# Off: NOTHING IS WRITTEN AND NOTHING IS READ. Every fact already remembered still
# reaches every prompt -- off means "write nothing new", never "hide what exists" --
# the readers just stop learning anything about the querent from here on.
#
# IT WRITES NOTHING, WHICH IS THE LOTUS'S BEHAVIOUR ON THE PERSONA'S HASH, and the
# combination is a THIRD shape rather than a rounding of the other two. SAFE and
# NECESSARY are two questions and the first two generators happened to answer both
# the same way. The hash here is the newest chat message id, so it moves on the
# querent's next sentence and storing a fallback would be SAFE; but nothing 500s on
# a missing row, so it is not NECESSARY, and there is no honest template version of
# "usually has nasi padang for dinner". flags.ts's header carries the table.
# Self-healing: the next completed run after this returns to `1` finds a moved hash
# and extracts normally.
#
# `1` rather than unset, for the reason the seven older flags are: unset behaves
# identically, so the value is not what the row is for -- BEING FINDABLE IS.
PROFILE_MEMORY_ENABLED=1

# The floor under regeneration, in seconds, on the CALLER's side.
#
# IT MUST NEVER GUARD A USER-CAUSED REGENERATION (A13). It does not, and cannot: a
# querent deleting a remembered fact edits the OUTPUT directly, so there is nothing
# to regenerate and profileMemoryStaleness has no `user-edit` arm at all. The floor
# lives in scheduleProfileExtraction and extractProfileMemory ignores it, so a
# future "refresh my memory now" control calls the second and is never throttled.
#
# 600 IS A GUESS AND NOT A MEASUREMENT, PERSONA_MIN_AGE_SECONDS' precedent. The hash
# moves on every message, so without a floor an active afternoon extracts after every
# completed run. Miftah's cost ruling means the honest direction to move it is DOWN.
PROFILE_MEMORY_MIN_AGE_SECONDS=600

# How many of the newest chat messages the extractor reads. NOT CHAT_CONTEXT_MESSAGES,
# and the two must never be unified: that one is 40 and is bounded by the dilution
# argument, because it sits in front of an INSTRUCTION a reader must obey. This sits in
# front of an EXTRACTION task whose whole job is to read a lot and write a little.
# Falls back to 200 rather than becoming zero; hard-capped at 500 in the query.
PROFILE_MEMORY_WINDOW=

# THE CHAT'S SHARE OF THE ROLLING FIVE-HOUR WINDOW. Defaults to HALF the hard
# ceiling -- 140 of 280.
#
# WITHOUT IT a single enthusiastic querent's afternoon reaches the soft line and
# every deferred feature in the app -- the gist, the day summary, the frequency
# verdict, the persona refresh -- goes quiet with them. A chat run is 2-5 model
# calls, and SIXTY RUNS WOULD EXHAUST THE WHOLE APP'S FIVE-HOUR QUOTA.
#
# The budget is PEEKED before the fleet ceiling and CONSUMED after it, so a call
# refused by either window is charged to neither. positive()'s rule applies: a
# garbage value falls back to the default rather than becoming ZERO, which would
# refuse every chat call in the app.
LLM_WINDOW_CHAT_CEILING=

# MAY THE READERS SEE THE SIX RAW ONBOARDING ANSWERS? (`C-D8`, granted by the
# reconciliation's `[R14]`.) Only the exact string `0` disables.
#
# THIS IS THE HIGHEST-CONSEQUENCE SETTING IN THE RELEASE. `C-D8` amends V8's rule
# A5 -- "THE PERSONA PROMPT NEVER RECEIVES A RAW ONBOARDING ANSWER" -- for the chat
# surface and only the chat surface, so that Thessaly can ask "emang nenek kamu
# meninggalnya kapan?". That question IS the product.
#
# It was granted ON CONDITION THAT IT BE REVERSIBLE WITHOUT REDEPLOYING THE PROMPT
# LAYER, because the two onboarding hints amended in the same release promised the
# opposite while the querent was typing the answer. This is that reversal.
#
# OFF DOES NOT CLOSE THE ROOM. The assembler omits the six-answer block; the Lotus
# summary, the engine facts and the transcript are untouched -- which is exactly
# the material the persona prompt has always had.
#
# DELIBERATELY NOT A flags.ts ENTRY: every member of DEFERRABLE_FLAGS gates a model
# CALL and has a call site flagCoverage.test.ts names. This gates an INPUT to a
# prompt. Putting it there would make "the set of model call sites is exactly its
# two tables" answerable in two incompatible ways.
CHAT_ANSWERS_ENABLED=1

# ---------------------------------------------------------------------------
# MAY A CARD READING SEE WHAT THE GROUP CHAT LEARNED? (card #34.) Only the exact
# string `0` disables.
#
# `CHAT_ANSWERS_ENABLED`'s sibling, pointing the other way across the same border.
# That variable governs whether the CHAT sees the six onboarding answers; this one
# governs whether a READING sees `user_memory` -- the short sentences a model wrote
# about the querent out of what they typed in the room. Both gate an INPUT to a
# prompt, both live with their feature rather than in flags.ts, and both exist so a
# claim in `/privacy` can be withdrawn in one dashboard edit.
#
# OFF COSTS NOTHING BUT THE TAILORING. `profile.read.ts` checks the flag BEFORE the
# database read, so `0` is zero queries rather than one wasted one, and the reading
# is exactly the one every querent who has never opened the chat gets. There is no
# degraded state and nothing to clean up afterwards.
#
# DELIBERATELY NOT A flags.ts ENTRY, for `CHAT_ANSWERS_ENABLED`'s reason above and
# one more that is specific to this variable: flags.test.ts asserts `READING_ENABLED`
# appears nowhere in that file, because switching the reading off does not degrade
# JMTarot, it ends it. A reading-shaped name in DEFERRABLE_FLAGS would read as
# exactly the switch that rule forbids.
#
# `/privacy` clauses 2.2, 2.8, 3 and 4.1 all describe this behaviour, and
# `legal.test.ts` holds all four. **Setting this to `0` makes those four clauses
# describe more than the code does, which is the safe direction; adding a SECOND
# surface that reads these notes without amending them is the unsafe one.**
READING_PROFILE_ENABLED=1

# --- v0.7.0: variables the other chat workstreams own ----------------------
#
# F1 owns this file for the release (seam S7) and writes the annotations from the
# prose those plans supply. Each carries its owner here so that a variable is never
# in this file with an empty explanation -- and so that an operator who finds one
# unset knows which plan to read.

# F2. Maximum beats in one run. RULED AT 4 by Miftah (`[R19]`): more voices in a
# run is the naturalness bet, and LLM_WINDOW_CHAT_CEILING is what bounds the cost
# -- not a cap on how many people may speak.
CHAT_MAX_BEATS=

# F3. How many past messages enter a voice's prompt.
CHAT_CONTEXT_MESSAGES=

# F3. How many past readings enter a voice's prompt.
CHAT_CONTEXT_READINGS=

# ── Proactivity (F5; retuned 2026-08-30 for R3) ─────────────────────────────
# CHAT_PROACTIVE_ENABLED is in flags.ts and is above. These SEVEN shape WHEN an
# unprompted run is allowed to exist. All seven are read AT CALL TIME. The five
# numeric ones fall back rather than becoming zero -- a gap of 0 makes three
# readers message you every time you load a page, and a cap of 0 deletes the
# feature; the two hour variables fall back to THEIR OWN DEFAULT rather than to
# 0, because `Number('') === 0` and this file ships them empty.
#
# THE 2026-08-30 RETUNE IS A RULING, NOT A MEASUREMENT. Miftah: "i want the
# readers to be much more PROACTIVE ... keep coming back to the chat group as
# often as possible." The gap came down 3h -> 1h, the cap went up 2 -> 5, the
# backlog TTL came down 48h -> 24h and the cron fan-out went 8 -> 20. WHAT MAKES
# ALL OF THAT PAYABLE IS THE TWO CHAT_QUIET_* KEYS BELOW, which are live for the
# first time in this release: before them the only thing standing between a
# querent and a 3 a.m. message was the nudge cron's single well-chosen hour.

# F5. How quiet the room must be before a reader speaks unprompted. ONE HOUR
# since 2026-08-30; it was three. Still a GUESS with an argument --
# PERSONA_MIN_AGE_SECONDS' precedent. Twenty minutes reads as a notification
# engine and that bound has not moved; twenty-four hours would make the daily
# cron the only source that ever fires, which the roadmap calls wrong.
# It does NOT gate a run triggered by a finished reading: that is a thing the
# querent just did, at a moment they are demonstrably present, and making Adrian
# wait to react to it is the feature not working.
# The only instrument that can move it is the proactive reply rate on
# /admin/chat over WEEKS. Measure before moving it.
CHAT_PROACTIVE_MIN_GAP_SECONDS=

# F5. Unprompted runs per querent per THEIR calendar day -- proactive_count_date
# is a 'YYYY-MM-DD' string, never a Date, for local_date's reason. FIVE since
# 2026-08-30; it was two. It counts runs MINTED and it does not refund.
# THE CAP IS ALMOST NEVER THE BINDING GATE -- no_material is. One material per
# run, and a spent material_key is spent for that querent for ever, so five
# means "up to five on a day the ladder has five distinct things to say". That
# holds ONLY because the time_of_day material is capped at one run per local day
# in detectTimeOfDay: its key is fresh in every part of every day and without
# that brake it alone would supply all five.
# The old ceiling's arithmetic still applies and is still the thing to watch: a
# PROACTIVE run is two to four beats (rule 11) rather than the eight-beat cap a
# querent-triggered run may reach, so five runs is a theoretical twenty
# unprompted messages in a day -- the bound v0.7.0 defended.
CHAT_PROACTIVE_MAX_PER_DAY=

# F5, and the reversal of [R17]. The querent's LOCAL quiet window: inclusive
# start hour, exclusive end hour, both 0-23. Defaults 22 and 7. A window that
# wraps midnight is the normal case.
#
# THE OFFSET COMES FROM chat_threads.utc_offset_minutes, which the browser
# reports. A NULL OFFSET MEANS NOT QUIET, NEVER BLOCKED -- a querent whose
# browser has not reported yet behaves exactly as they did before this shipped.
#
# IT DOES NOT GATE A RUN TRIGGERED BY A FINISHED READING, for the same reason
# the gap does not: somebody who takes a reading at 02:00 is awake and in the
# app. It DOES gate a tick, which is a page load rather than a request for a
# conversation.
#
# THE KNOWN COST IS THE 05:00 RUNNER, and the escape hatch is this variable
# rather than a code change: CHAT_QUIET_TO_HOUR=5.
#
# TO DISABLE QUIET HOURS ENTIRELY, SET BOTH TO THE SAME NUMBER. A non-wrapping
# window of zero length matches no hour, so there is no third variable for it.
# An empty value, a non-integer or anything outside 0-23 falls back to the
# DEFAULT for that key -- never to 0.
CHAT_QUIET_FROM_HOUR=
CHAT_QUIET_TO_HOUR=

# F5. After this long, an unanswered reader question is not "still unanswered",
# it is over. Following up on something asked last Tuesday reads as a cron job
# that found a row. Default 48.
UNANSWERED_MAX_AGE_HOURS=

# F5. A run left pending or running for this long is abandoned by the nudge
# cron, BEFORE it mints anything. TWENTY-FOUR since 2026-08-30; it was 48, and
# it came down because the material got day-shaped: a "udah senin aja" greeting
# delivered on Wednesday is worse than silence. The cost is recorded rather than
# hidden -- a quota outage longer than a day now loses the runs it sheds instead
# of holding them, which is the right trade for a run nobody was waiting for.
# Default 24.
PROACTIVE_RUN_TTL_HOURS=

# F5. How many querents /api/cron/nudge will MINT for in one 60s invocation.
# Twenty since 2026-08-30; it was 8, and the old number conflated two limits.
# The 45s wall-clock budget bounds the WARM and enforces itself -- the loop stops
# advancing while it keeps minting. A mint is ~100ms, so twenty is ~2s and the
# rest of the budget still buys the same ~7 warms; the other thirteen runs stay
# `pending` and the querent's next tick delivers them. At a scale where this is
# too few the fix is NOT a bigger number -- it is that the cron mints only and a
# queue drains it, a v0.8.0 mechanism named here so nobody invents it in an
# emergency. Default 20.
NUDGE_MAX_USERS=
