.DS_Store

# Secrets. LLM_API_KEY, AUTH_SECRET and AUTH_USERS live here.
# `.env.example` is committed; nothing matching these patterns ever is.
.env
.env.local
.env*.local

# Google hands you the OAuth client as a download named client_secret_<id>.json.
# Nothing in this project reads it -- the two values it holds belong in
# .env.local -- but the default download lands in whatever directory you were
# in, and without this line the repo root is a plausible one. A committed
# client secret means rotating the OAuth client and re-registering every
# redirect URI.
client_secret*.json

# Local harnesses that plant a session cookie so headless Chrome, or a
# same-origin iframe, can reach gated pages. They live under public/cards/
# because that path is excluded from the middleware matcher -- which is the only
# reason they load at all, and also the reason they must never be committed:
# anything served from public/ is served to the internet.
#
# They are only useful with DEV_PASSWORD_LOGIN=1, which cannot be on in a
# deployment, so a leaked one would be inert rather than an open door. Ignored
# anyway: "inert because of a flag somewhere else" is not a property to bet a
# login on.
public/cards/_seed.html
public/cards/_*.html

# Source art is kept, but the normalized output is generated by
# tools/normalize_cards.py -- keep it committed so Vercel builds without Python.
tools/_contactsheet.jpg

# git worktrees
.worktrees/
